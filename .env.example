# Where your Obsidian vault is. ScrollWright writes notes to <VAULT_PATH>/ScrollWright/
# Example Windows: C:/Users/you/Documents/MyVault   Example macOS/Linux: ~/Documents/MyVault
VAULT_PATH=

# Get a free key at https://aistudio.google.com/apikey (free tier, no card needed)
GEMINI_API_KEY=

# Optional: your Instagram username, used only to detect and skip reels you posted
IG_USERNAME=

# Optional: set to false to skip video-watching (audio+caption only; ~4x fewer tokens)
# WATCH_VIDEOS=true

# Optional: whisper model size: tiny | base | small (default) | medium | large-v3
# WHISPER_MODEL=small
