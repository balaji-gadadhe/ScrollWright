{
  "manifest_version": 3,
  "name": "ScrollWright Exporter",
  "version": "1.1.0",
  "description": "One click turns a reel into an Obsidian note. Harvest saved folders. Local-only, nothing leaves your machine except to Gemini.",
  "permissions": ["activeTab", "scripting", "downloads"],
  "host_permissions": ["https://www.instagram.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ScrollWright"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
